+it('debug CDP mechanism', async ({ context }) => {
+  console.log('=== CDP机制调试开始 ===');
+  
+  const page = await context.newPage();
+  const cdpSession = await context.newCDPSession(page);
+  
+  console.log('1. 检查浏览器启动参数和状态...');
+  
+  // 检查用户代理，了解浏览器状态
+  const userAgent = await page.evaluate(() => navigator.userAgent);
+  console.log('用户代理:', userAgent);
+  
+  // 检查是否有自动化标识
+  const isAutomated = await page.evaluate(() => {
+    return {
+      webdriver: navigator.webdriver,
+      automationControlled: window.chrome && window.chrome.runtime && window.chrome.runtime.onConnect ? 'chrome.runtime存在' : 'chrome.runtime不存在',
+      playwrightPresent: typeof window.__playwright !== 'undefined'
+    };
+  });
+  console.log('自动化状态:', isAutomated);
+  
+  console.log('2. 测试其他CDP命令是否正常工作...');
+  
+  try {
+    // 测试获取文档信息
+    const docInfo = await cdpSession.send('DOM.getDocument');
+    console.log('DOM.getDocument成功，nodeId:', docInfo.root.nodeId);
+    
+    // 测试运行时评估
+    const evalResult = await cdpSession.send('Runtime.evaluate', {
+      expression: 'window.runtimeTest = "RUNTIME_WORKS"; window.runtimeTest;'
+    });
+    console.log('Runtime.evaluate成功，result:', evalResult.result.value);
+  } catch (error) {
+    console.error('其他CDP命令失败:', error);
+  }
+  
+  console.log('3. 测试基本的CDP addScriptToEvaluateOnNewDocument...');
+  
+  try {
+    const result1 = await cdpSession.send('Page.addScriptToEvaluateOnNewDocument', {
+      source: `
+        console.log('CDP测试脚本执行！');
+        window.cdpTest = 'CDP_WORKING';
+      `
+    });
+    console.log('CDP调用成功，identifier:', result1.identifier);
+    
+    // 尝试带runImmediately参数的版本
+    const result2 = await cdpSession.send('Page.addScriptToEvaluateOnNewDocument', {
+      source: `
+        console.log('CDP立即执行脚本！');
+        window.cdpTestImmediate = 'CDP_IMMEDIATE';
+      `,
+      runImmediately: true
+    });
+    console.log('CDP立即执行调用成功，identifier:', result2.identifier);
+    
+    // 测试不同类型的脚本注入
+    const result3 = await cdpSession.send('Page.addScriptToEvaluateOnNewDocument', {
+      source: `window.cdpTest3 = 'SIMPLE_TEST';`
+    });
+    console.log('简单脚本调用成功，identifier:', result3.identifier);
+    
+    // 测试是否支持世界隔离
+    const result4 = await cdpSession.send('Page.addScriptToEvaluateOnNewDocument', {
+      source: `window.cdpTest4 = 'WORLD_TEST';`,
+      worldName: 'main'
+    });
+    console.log('世界隔离脚本调用成功，identifier:', result4.identifier);
+  } catch (error) {
+    console.error('CDP调用失败:', error);
+  }
+  
+  // 在导航前先等待，确保脚本被正确注册
+  await new Promise(resolve => setTimeout(resolve, 100));
+  
+  await page.goto('data:text/html,<html><body>Test</body></html>');
+  
+  const cdpTestResult = await page.evaluate(() => window.cdpTest);
+  const cdpTestImmediateResult = await page.evaluate(() => window.cdpTestImmediate);
+  const cdpTest3Result = await page.evaluate(() => window.cdpTest3);
+  const cdpTest4Result = await page.evaluate(() => window.cdpTest4);
+  const runtimeTestResult = await page.evaluate(() => window.runtimeTest);
+  console.log('CDP测试结果:', cdpTestResult);
+  console.log('CDP立即执行结果:', cdpTestImmediateResult);
+  console.log('CDP简单脚本结果:', cdpTest3Result);
+  console.log('CDP世界隔离结果:', cdpTest4Result);
+  console.log('Runtime.evaluate结果:', runtimeTestResult);
+  
+  // 重新加载页面，看看脚本是否执行
+  console.log('重新加载页面以检查脚本执行...');
+  await page.reload();
+  
+  const cdpTestResult2 = await page.evaluate(() => window.cdpTest);
+  console.log('重新加载后的CDP测试结果:', cdpTestResult2);
+  
+  console.log('2. 检查现有绑定系统的脚本注入...');
+  
+  // 先检查是否能看到控制器初始化的日志
+  const consoleLogs = [];
+  page.on('console', msg => {
+    console.log(`页面控制台[${msg.type()}]:`, msg.text());
+    consoleLogs.push(msg.text());
+  });
+  
+  // 模拟exposeBinding的过程
+  await context.exposeBinding('debugAdd', (source, a, b) => {
+    console.log('debugAdd 被调用:', a, b);
+    return a + b;
+  });
+  
+  const page2 = await context.newPage();
+  // 先检查日志，再导航
+  await page2.goto('data:text/html,<html><body>Test Page 2</body></html>');
+  
+  // 等待一下让日志输出
+  await new Promise(resolve => setTimeout(resolve, 200));
+  
+  // 检查绑定是否存在
+  const bindingExists = await page2.evaluate(() => {
+    return typeof globalThis.debugAdd === 'function';
+  });
+  console.log('绑定函数存在:', bindingExists);
+  
+  // 检查控制器是否存在
+  const controllerExists = await page2.evaluate(() => {
+    return typeof globalThis['__nx_controller__'] === 'object';
+  });
+  console.log('控制器存在:', controllerExists);
+  
+  // 检查控制器的详细信息
+  if (controllerExists) {
+    const controllerInfo = await page2.evaluate(() => {
+      const controller = globalThis['__nx_controller__'];
+      return {
+        hasAddBinding: typeof controller.addBinding === 'function',
+        constructor: controller.constructor.name
+      };
+    });
+    console.log('控制器详细信息:', controllerInfo);
+  }
+  
+  if (bindingExists) {
+    try {
+      const result = await page2.evaluate('debugAdd(10, 20)');
+      console.log('绑定调用结果:', result);
+    } catch (e) {
+      console.log('绑定调用失败:', e.message);
+    }
+  }
+  
+  console.log('=== CDP机制调试结束 ===');
+});
