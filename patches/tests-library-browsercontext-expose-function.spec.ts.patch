+it('基础绑定机制测试', async ({ context }) => {
+  console.log('=== 基础绑定机制测试开始 ===');
+  
+  // 先创建一个页面（模拟CDP测试的模式）
+  const tempPage = await context.newPage();
+  console.log('临时页面创建完成');
+  
+  // 创建一个简单的绑定
+  await context.exposeBinding('simpleAdd', (source, a, b) => {
+    console.log('simpleAdd 被调用:', a, b);
+    return a + b;
+  });
+  console.log('绑定创建完成');
+  
+  // 创建新页面来测试绑定
+  const page = await context.newPage();
+  console.log('测试页面创建完成');
+  
+  // 检查绑定是否存在
+  const bindingExists = await page.evaluate(() => {
+    return typeof globalThis.simpleAdd === 'function';
+  });
+  console.log('绑定函数是否存在:', bindingExists);
+  
+  // 检查控制器是否存在
+  const controllerExists = await page.evaluate(() => {
+    return typeof globalThis['__nx_controller__'] === 'object' && globalThis['__nx_controller__'] !== null;
+  });
+  console.log('控制器是否存在:', controllerExists);
+  
+  // 如果控制器存在，查看详细信息
+  if (controllerExists) {
+    const controllerInfo = await page.evaluate(() => {
+      const ctrl = globalThis['__nx_controller__'];
+      return {
+        hasAddBinding: typeof ctrl.addBinding === 'function',
+        hasRemoveBinding: typeof ctrl.removeBinding === 'function',
+        constructor: ctrl.constructor.name
+      };
+    });
+    console.log('控制器详细信息:', controllerInfo);
+  }
+  
+  // 尝试调用绑定函数
+  if (bindingExists) {
+    try {
+      const result = await page.evaluate('simpleAdd(3, 7)');
+      console.log('绑定调用成功，结果:', result);
+    } catch (error) {
+      console.log('绑定调用失败:', error.message);
+    }
+  } else {
+    console.log('绑定函数不存在，无法测试调用');
+  }
+  
+  console.log('=== 基础绑定机制测试结束 ===');
+});
